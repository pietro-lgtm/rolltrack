# Dominio público definitivo (canonical, sitemap, Open Graph)
SITE_URL=https://reenergygroup.com
# Endpoint POST para formularios (Formspree, Getform, backend propio). Vacío = respaldo por correo.
PUBLIC_FORM_ENDPOINT=
# Video principal de campaña (p. ej. /media/orchidean-one.mp4). Vacío = foto con movimiento lento.
PUBLIC_HERO_VIDEO=
# true = visible en Google. Vacío/false = en línea pero oculto de buscadores (noindex).
PUBLIC_INDEXABLE=
