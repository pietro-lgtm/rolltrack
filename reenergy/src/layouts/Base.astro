---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/gelasio/400.css';
import '@fontsource/gelasio/400-italic.css';
import '@fontsource/gelasio/700.css';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LangHint from '../components/LangHint.astro';
import { ROUTES, type Lang, type RouteKey } from '../lib/i18n';
import { SITE } from '../data/site';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  ogImage?: string;
  ogAlt?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, route, title, description, ogImage, ogAlt, jsonLd = [], noindex = false } = Astro.props;

const base = SITE.url.replace(/\/$/, '');
const abs = (p: string) => base + p;
const canonical = abs(ROUTES[route][lang]);
const esUrl = abs(ROUTES[route].es);
const enUrl = abs(ROUTES[route].en);
const image = abs(ogImage ?? `/og/${route}-${lang}.png`);
const fullTitle = route === 'home' ? title : `${title} · Orchidean One`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${base}/#org`,
  name: 'Reenergy',
  url: base + '/',
  logo: `${base}/brand/reenergy-logo.png`,
  email: SITE.email,
  areaServed: { '@type': 'Country', name: 'Costa Rica' },
  description:
    lang === 'es'
      ? 'Reenergy desarrolla Orchidean One, una planta de valorización energética que transforma la basura de Costa Rica en electricidad.'
      : 'Reenergy is developing Orchidean One, a waste-to-energy plant that turns Costa Rica’s trash into electricity.',
  sameAs: Object.values(SITE.social).filter(Boolean),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${base}/#website`,
  name: 'Orchidean One · Reenergy',
  url: base + '/',
  inLanguage: ['es-CR', 'en'],
  publisher: { '@id': `${base}/#org` },
};
const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: lang === 'es' ? 'es-CR' : 'en',
  isPartOf: { '@id': `${base}/#website` },
  about: { '@id': `${base}/#plant` },
  primaryImageOfPage: image,
};
const ld = [org, website, webpage, ...jsonLd];
---

<!doctype html>
<html lang={lang === 'es' ? 'es-CR' : 'en'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || !SITE.indexable) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-CR" href={esUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orchidean One · Reenergy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body data-lang={lang}>
    <SiteHeader lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} route={route} />
    <LangHint lang={lang} route={route} />

    <script>
      // Animación de entrada suave al hacer scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
