---
import { ROUTES, UI, type Lang, type RouteKey } from '../lib/i18n';
import { SITE } from '../data/site';
interface Props {
  lang: Lang;
  route: RouteKey;
  label: string;
  dark?: boolean;
}
const { lang, route, label, dark = false } = Astro.props;
const base = SITE.url.replace(/\/$/, '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: UI[lang].breadcrumbHome, item: base + ROUTES.home[lang] },
    { '@type': 'ListItem', position: 2, name: label, item: base + ROUTES[route][lang] },
  ],
};
---

<nav class:list={['crumbs', { dark }]} aria-label={lang === 'es' ? 'Ruta' : 'Breadcrumb'}>
  <a href={ROUTES.home[lang]}>{UI[lang].breadcrumbHome}</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">{label}</span>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .crumbs { display: flex; gap: 8px; align-items: center; font-family: var(--font-title); font-size: 14px; color: var(--ink-soft); margin-bottom: 28px; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .dark { color: rgba(249, 246, 228, 0.75); }
</style>
