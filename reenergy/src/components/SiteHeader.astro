---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { ROUTES, UI, other, type Lang, type RouteKey } from '../lib/i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const ui = UI[lang];
const alt = other(lang);
const primary: RouteKey[] = ['crisis', 'plant', 'air', 'world', 'build', 'faq'];
const secondary: RouteKey[] = ['gov', 'monitor', 'press'];
---

<a class="skip-link" href="#main">{ui.skip}</a>
<header class="site-header" data-elevated="false">
  <div class="wrap bar">
    <a class="brand" href={ROUTES.home[lang]} aria-label="ReEnergy — Orchidean One">
      <Logo class="brand-logo" />
    </a>

    <nav class="primary-nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul>
        {
          primary.map((k) => (
            <li>
              <a href={ROUTES[k][lang]} aria-current={k === route ? 'page' : undefined}>
                {ui.nav[k]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a
        class="lang-toggle"
        href={ROUTES[route][alt]}
        hreflang={alt}
        lang={alt}
        aria-label={ui.langSwitchLabel}
        data-set-lang={alt}
      >
        <Icon name="languages" size={18} />
        <span class="lang-long">{ui.langSwitch}</span>
        <span class="lang-short">{ui.langSwitchShort}</span>
      </a>
      <a class="btn btn-sprout header-cta" href={ROUTES.minute[lang]}>
        <Icon name="play" size={16} />
        {ui.nav.minute}
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" size={24} class="i-open" />
        <Icon name="x" size={24} class="i-close" />
        <span class="sr-only">{ui.menu}</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="wrap" aria-label={ui.menu}>
      <ul class="mm-primary">
        <li>
          <a href={ROUTES.minute[lang]} class="mm-feature">
            <Icon name="play" size={22} />
            {ui.nav.minute}
          </a>
        </li>
        {
          primary.map((k) => (
            <li>
              <a href={ROUTES[k][lang]} aria-current={k === route ? 'page' : undefined}>
                {ui.nav[k]}
                <Icon name="arrowRight" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mm-secondary">
        {
          secondary.map((k) => (
            <li>
              <a href={ROUTES[k][lang]}>{ui.nav[k]}</a>
            </li>
          ))
        }
        <li>
          <a href={ROUTES[route][alt]} hreflang={alt} lang={alt} data-set-lang={alt}>
            <Icon name="languages" size={18} />
            {ui.langSwitch}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: absolute; left: 12px; top: -60px; z-index: 100;
    background: var(--lago); color: var(--sky); padding: 10px 16px; border-radius: 10px;
    font-family: var(--font-title);
  }
  .skip-link:focus { top: 12px; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(249, 246, 228, 0.88);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .site-header[data-elevated='true'] { border-bottom-color: var(--line); box-shadow: 0 8px 24px -18px rgba(20, 30, 10, 0.4); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 72px; }
  .brand { display: flex; align-items: center; flex: none; }
  .brand :global(.brand-logo) { height: 34px; width: auto; }

  .primary-nav { display: none; margin-left: auto; }
  .primary-nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .primary-nav a {
    display: block; padding: 10px 12px; border-radius: 999px;
    font-family: var(--font-title); font-size: 15px; color: var(--ink); text-decoration: none; white-space: nowrap;
    transition: background-color 0.2s;
  }
  .primary-nav a:hover { background: rgba(161, 201, 62, 0.22); }
  .primary-nav a[aria-current='page'] { background: var(--sprout); color: var(--lago-night); }

  .actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  .primary-nav + .actions { margin-left: 8px; }

  .lang-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 44px; padding: 0 14px; border-radius: 999px;
    border: 1.5px solid var(--lago); color: var(--lago);
    font-family: var(--font-title); font-weight: 500; font-size: 15px; text-decoration: none; white-space: nowrap;
    transition: background-color 0.2s, color 0.2s;
  }
  .lang-toggle:hover { background: var(--lago); color: var(--sky); }
  .lang-long { display: none; }

  .header-cta { display: none; min-height: 44px; font-size: 15px; padding-inline: 1.1em; white-space: nowrap; }

  .menu-btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    border: 0; background: var(--lago); color: var(--sky); cursor: pointer;
  }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }

  .mobile-menu {
    position: fixed; inset: 72px 0 0 0; z-index: 49;
    background: var(--sky); overflow-y: auto; padding: 16px 0 48px;
    border-top: 1px solid var(--line);
  }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mm-primary a {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 16px 4px; border-bottom: 1px solid var(--line);
    font-family: var(--font-title); font-size: 24px; color: var(--ink); text-decoration: none;
  }
  .mm-primary a[aria-current='page'] { color: var(--lago); }
  .mm-primary .mm-feature {
    justify-content: flex-start; background: var(--sprout); color: var(--lago-night);
    border-radius: 18px; padding: 18px 20px; border: 0; margin-bottom: 8px;
  }
  .mm-secondary { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px !important; }
  .mm-secondary a {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 16px; border-radius: 999px; background: var(--cream-2);
    font-family: var(--font-title); font-size: 16px; color: var(--ink); text-decoration: none;
  }

  @media (min-width: 560px) {
    .header-cta { display: inline-flex; }
  }
  @media (min-width: 760px) {
    .lang-long { display: inline; }
    .lang-short { display: none; }
  }
  @media (min-width: 1180px) {
    .primary-nav { display: block; }
    .menu-btn { display: none; }
    .brand :global(.brand-logo) { height: 36px; }
  }
  @media (min-width: 1180px) and (max-width: 1300px) {
    .primary-nav a { padding-inline: 9px; font-size: 14.5px; }
    .lang-long { display: none; }
    .lang-short { display: inline; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  const onScroll = () => header?.setAttribute('data-elevated', String(window.scrollY > 8));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1180) setOpen(false);
  });

  // Recordar el idioma elegido (para el aviso de idioma)
  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('rp-lang', a.dataset.setLang || '');
      } catch {}
    }),
  );
</script>
