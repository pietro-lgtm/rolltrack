---
/**
 * Municipalidades e instituciones — la página para tomadores de decisión.
 * Más densa, más técnica, imprimible como ficha (botón "Descargar ficha").
 * ⚠️ Ficha técnica: valores de diseño a confirmar por ingeniería; modelo comercial a confirmar.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Ref from '../components/Ref.astro';
import SignupForm from '../components/SignupForm.astro';
import Sources from '../components/Sources.astro';
import { ROUTES, fmt, type Lang } from '../lib/i18n';
import { PROJECT, sourceList, type SourceKey } from '../data/facts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
const refs: SourceKey[] = ['huazo', 'santaAna', 'desamparados', 'limon300', 'ley8839', 'dec39136', 'setena', 'ied', 'ice2024'];
const r = (k: SourceKey) => refs.indexOf(k) + 1;

const value = es
  ? [
      { icon: 'shield', t: 'Destino seguro', d: 'Un lugar estable y de largo plazo para la basura del cantón, sin depender de rellenos que cierran.', k: 'huazo' as SourceKey },
      { icon: 'scale', t: 'Precio predecible', d: 'Tarifa por tonelada en contrato de largo plazo, en lugar de aumentos repentinos como los de 2025–2026.', k: 'santaAna' as SourceKey },
      { icon: 'road', t: 'Menos kilómetros', d: 'Viajes más cortos que bajan costos de transporte y desgaste de flota.', k: 'limon300' as SourceKey },
      { icon: 'fileText', t: 'Cumplimiento de ley', d: 'Avanza la jerarquía de la Ley 8839: menos disposición final, más valorización.', k: 'ley8839' as SourceKey },
      { icon: 'chart', t: 'Datos por cantón', d: 'Reportes de toneladas entregadas, energía generada y emisiones, listos para el concejo y la Contraloría.', k: null },
      { icon: 'users', t: 'Buena noticia para el vecino', d: 'Un proyecto que se puede explicar con orgullo: menos basura enterrada, más energía y transparencia.', k: null },
    ]
  : [
      { icon: 'shield', t: 'A secure destination', d: 'A stable, long-term destination for the canton’s trash, without relying on landfills that close.', k: 'huazo' as SourceKey },
      { icon: 'scale', t: 'Predictable price', d: 'A per-tonne fee under a long-term contract, instead of sudden hikes like those of 2025–2026.', k: 'santaAna' as SourceKey },
      { icon: 'road', t: 'Fewer kilometers', d: 'Shorter trips that cut transport costs and fleet wear.', k: 'limon300' as SourceKey },
      { icon: 'fileText', t: 'Legal compliance', d: 'Moves up Law 8839’s hierarchy: less final disposal, more recovery.', k: 'ley8839' as SourceKey },
      { icon: 'chart', t: 'Data by canton', d: 'Reports on tonnes delivered, energy generated and emissions, ready for the council and the Comptroller.', k: null },
      { icon: 'users', t: 'Good news for residents', d: 'A project you can explain with pride: less buried trash, more energy and transparency.', k: null },
    ];

const sheet = es
  ? [
      ['Tipo de instalación', 'Planta de valorización energética de residuos sólidos ordinarios'],
      ['Tecnología', 'Combustión en parrilla con recuperación de energía (caldera + turbina de vapor)'],
      ['Capacidad', `Hasta ${fmt(PROJECT.capacityTpd, 'es')} t/día*`],
      ['Potencia eléctrica', `~${PROJECT.powerMW} MW netos*`],
      ['Equivalente', `~${fmt(PROJECT.homes, 'es')} hogares*`],
      ['Temperatura de combustión', `≥ ${PROJECT.furnaceC} °C durante ≥ 2 s`],
      ['Tratamiento de gases', 'Control de NOx, neutralización de ácidos, carbón activado y filtro de mangas*'],
      ['Norma de diseño de emisiones', 'Directiva 2010/75/UE y Decreto 39136-S-MINAE'],
      ['Monitoreo', 'Medición continua en chimenea con publicación en línea'],
      ['Reducción de volumen', `~${PROJECT.volumeReduction}%`],
      ['Terreno', `${PROJECT.areaHa} ha*`],
      ['Construcción', `~${PROJECT.constructionMonths} meses tras permisos*`],
      ['Empleo', `~${PROJECT.jobsConstruction} en obra · ~${PROJECT.jobsOperation} permanentes*`],
      ['Inversión', 'Privada, por Reenergy*'],
    ]
  : [
      ['Facility type', 'Waste-to-energy plant for ordinary municipal solid waste'],
      ['Technology', 'Grate combustion with energy recovery (boiler + steam turbine)'],
      ['Capacity', `Up to ${fmt(PROJECT.capacityTpd, 'en')} t/day*`],
      ['Electrical output', `~${PROJECT.powerMW} MW net*`],
      ['Equivalent', `~${fmt(PROJECT.homes, 'en')} homes*`],
      ['Combustion temperature', `≥ ${PROJECT.furnaceC} °C for ≥ 2 s`],
      ['Flue-gas treatment', 'NOx control, acid neutralization, activated carbon and bag filter*'],
      ['Emissions design standard', 'Directive 2010/75/EU and Decree 39136-S-MINAE'],
      ['Monitoring', 'Continuous stack measurement, published online'],
      ['Volume reduction', `~${PROJECT.volumeReduction}%`],
      ['Land', `${PROJECT.areaHa.replace(' a ', '–')} ha*`],
      ['Construction', `~${PROJECT.constructionMonths} months after permits*`],
      ['Employment', `~${PROJECT.jobsConstruction.replace('.', ',')} construction · ~${PROJECT.jobsOperation} permanent*`],
      ['Investment', 'Private, by Reenergy*'],
    ];

const legal = es
  ? [
      { t: 'Ley 8839', d: 'Gestión Integral de Residuos. Jerarquía: evitar, reducir, reutilizar, valorizar (incluye aprovechamiento energético), tratar y disponer.', k: 'ley8839' as SourceKey },
      { t: 'Decreto 39136-S-MINAE', d: 'Condiciones de operación y control de emisiones para tratamiento térmico de residuos sólidos ordinarios (2015).', k: 'dec39136' as SourceKey },
      { t: 'SETENA', d: 'Evaluación de impacto ambiental: D1, Estudio de Impacto Ambiental y viabilidad ambiental.', k: 'setena' as SourceKey },
      { t: 'Municipalidad', d: 'Certificado de uso de suelo según plan regulador y permisos de construcción.', k: null },
    ]
  : [
      { t: 'Law 8839', d: 'Integrated Waste Management. Hierarchy: avoid, reduce, reuse, recover (including energy recovery), treat and dispose.', k: 'ley8839' as SourceKey },
      { t: 'Decree 39136-S-MINAE', d: 'Operating conditions and emissions control for thermal treatment of ordinary solid waste (2015).', k: 'dec39136' as SourceKey },
      { t: 'SETENA', d: 'Environmental impact assessment: D1 form, Environmental Impact Study and environmental approval.', k: 'setena' as SourceKey },
      { t: 'Municipality', d: 'Land-use certificate under the zoning plan, and building permits.', k: null },
    ];

const c = es
  ? {
      title: 'Para municipalidades e instituciones: ficha técnica de Orchidean One',
      desc: 'Información técnica de Orchidean One para municipalidades, concejos e instituciones: beneficios para el cantón, ficha técnica, marco legal (Ley 8839, Decreto 39136, SETENA) y solicitud de reunión técnica.',
    }
  : {
      title: 'For municipalities and institutions: Orchidean One fact sheet',
      desc: 'Technical information on Orchidean One for municipalities, councils and institutions: benefits for the canton, fact sheet, legal framework (Law 8839, Decree 39136, SETENA) and technical meeting requests.',
    };
---

<Base lang={lang} route="gov" title={c.title} description={c.desc}>
  <PageHero
    lang={lang}
    route="gov"
    crumb={es ? 'Municipalidades' : 'Municipalities'}
    tone="night"
    eyebrow={es ? 'Municipalidades e instituciones' : 'Municipalities & institutions'}
    title={es ? 'Una salida de largo plazo para la basura de su cantón.' : 'A long-term answer for your canton’s trash.'}
    lead={es ? 'Lo que necesita saber para decidir: qué gana el cantón, la ficha técnica, el marco legal y cómo empezar la conversación.' : 'What you need to know to decide: what the canton gains, the fact sheet, the legal framework and how to start the conversation.'}
  >
    <Fragment slot="actions">
      <button type="button" class="btn btn-sprout no-print" onclick="window.print()"><Icon name="download" />{es ? 'Descargar ficha (PDF)' : 'Download fact sheet (PDF)'}</button>
      <a class="btn btn-ghost no-print" href="#reunion">{es ? 'Solicitar reunión' : 'Request a meeting'}</a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="measure mb-3">
        <p class="eyebrow">{es ? 'Qué gana el cantón' : 'What the canton gains'}</p>
        <h2>{es ? 'Seis razones para el concejo.' : 'Six reasons for the council.'}</h2>
        <p class="lead">{es ? 'Los rellenos del Valle Central están al límite y las tarifas ya subieron en varios cantones. Orchidean One ofrece estabilidad.' : 'Central Valley landfills are at their limit and fees have already gone up in several cantons. Orchidean One offers stability.'}<Ref n={r('huazo')} /><Ref n={r('desamparados')} /></p>
      </div>
      <div class="grid grid-3">
        {
          value.map((v) => (
            <article class="card">
              <span class="icon-badge lago">
                <Icon name={v.icon} />
              </span>
              <h3 class="vt">{v.t}</h3>
              <p class="mb-0">
                {v.d}
                {v.k && <Ref n={r(v.k)} />}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="ficha">
    <div class="wrap split split-40 sheet-sec">
      <div>
        <p class="eyebrow">{es ? 'Ficha técnica' : 'Fact sheet'}</p>
        <h2>{es ? 'Orchidean One en una tabla.' : 'Orchidean One in one table.'}</h2>
        <p>{es ? 'Para informes técnicos, sesiones de concejo y comisiones legislativas.' : 'For technical reports, council sessions and legislative committees.'}</p>
        <button type="button" class="btn no-print" onclick="window.print()"><Icon name="printer" />{es ? 'Imprimir o guardar PDF' : 'Print or save PDF'}</button>
      </div>
      <div class="table-wrap">
        <table class="sheet">
          <tbody>
            {
              sheet.map(([k, v]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td>{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="source sheet-note">{es ? '* Valores de diseño preliminares, sujetos a ingeniería de detalle, caracterización de residuos y permisos.' : '* Preliminary design values, subject to detailed engineering, waste characterization and permits.'}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="measure mb-3">
        <p class="eyebrow">{es ? 'Marco legal' : 'Legal framework'}</p>
        <h2>{es ? 'Dentro de la ley costarricense.' : 'Within Costa Rican law.'}</h2>
      </div>
      <div class="grid grid-4">
        {
          legal.map((l) => (
            <article class="card card-flat">
              <h3 class="vt">{l.t}</h3>
              <p class="mb-0">
                {l.d}
                {l.k && <Ref n={r(l.k)} />}
              </p>
            </article>
          ))
        }
      </div>
      <p class="mt-2">{es ? 'Además, la electricidad firme aporta seguridad al sistema eléctrico nacional, que en 2024 tuvo racionamientos y alto gasto en generación térmica e importaciones.' : 'Firm power also adds security to the national grid, which in 2024 saw blackouts and high spending on thermal generation and imports.'}<Ref n={r('ice2024')} /></p>
    </div>
  </section>

  <section class="section on-dark" id="reunion">
    <div class="wrap split split-40">
      <div>
        <p class="eyebrow">{es ? 'Hablemos' : 'Let’s talk'}</p>
        <h2>{es ? 'Solicite una reunión técnica.' : 'Request a technical meeting.'}</h2>
        <p class="lead">{es ? 'Presentamos el proyecto a alcaldías, concejos, federaciones municipales, comisiones y equipos técnicos.' : 'We present the project to mayors, councils, municipal federations, committees and technical teams.'}</p>
        <p><a href={ROUTES.monitor[lang]}>{es ? 'Ver cómo funcionará el monitoreo público →' : 'See how public monitoring will work →'}</a></p>
      </div>
      <SignupForm lang={lang} variant="gov" tone="dark" />
    </div>
  </section>

  <Sources lang={lang} items={sourceList(refs)} />
</Base>

<style>
  .vt { font-family: var(--font-title); margin-top: 18px; }
  .card-flat .vt { margin-top: 0; color: var(--lago); }
  .sheet-sec { align-items: start; }
  .table-wrap { border-radius: var(--radius); background: var(--paper); border: 1px solid var(--line); overflow: hidden; box-shadow: var(--shadow); }
  .sheet { width: 100%; border-collapse: collapse; font-size: 16px; }
  .sheet th, .sheet td { padding: 13px 20px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .sheet th { font-family: var(--font-title); font-weight: 500; font-size: 14.5px; width: 38%; color: var(--lago); }
  .sheet-note { padding: 0 20px 16px; }
  @media print {
    .sheet th { color: #000; }
  }
</style>
