---
/**
 * Preguntas frecuentes accesibles (<details>) + datos estructurados FAQPage para Google.
 */
interface Item {
  q: string;
  a: string; // HTML simple permitido (enlaces, <strong>)
}
interface Props {
  items: Item[];
  schema?: boolean;
  open?: number;
}
const { items, schema = true, open = -1 } = Astro.props;
const strip = (h: string) => h.replace(/<[^>]+>/g, '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: strip(i.a) },
  })),
};
---

<div class="faq">
  {
    items.map((i, idx) => (
      <details open={idx === open}>
        <summary>
          <span>{i.q}</span>
          <span class="faq-plus" aria-hidden="true" />
        </summary>
        <div class="faq-a" set:html={i.a} />
      </details>
    ))
  }
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

<style>
  .faq { display: grid; gap: 12px; }
  details { background: var(--paper); border: 1px solid var(--line); border-radius: 18px; transition: box-shadow 0.25s var(--ease); }
  details[open] { box-shadow: var(--shadow); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    padding: 20px 22px; min-height: 64px;
    font-family: var(--font-title); font-size: max(17px, calc(var(--u) * 3)); line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .faq-plus { width: 34px; height: 34px; border-radius: 50%; background: var(--sprout); flex: none; position: relative; }
  .faq-plus::before, .faq-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; background: var(--lago-night); transform: translate(-50%, -50%); transition: transform 0.25s var(--ease); }
  .faq-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .faq-plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-a { padding: 0 22px 22px; max-width: 46rem; }
  .faq-a :global(p:last-child) { margin-bottom: 0; }
</style>
