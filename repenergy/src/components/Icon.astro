const custom: Record<string, string> = {
  whatsapp:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.16.25-.64.8-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>',
  facebook:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.53l.38-2.93H13.5V8.7c0-.85.24-1.43 1.46-1.43h1.55V4.65a20.6 20.6 0 0 0-2.26-.12c-2.24 0-3.77 1.37-3.77 3.88v2.16H7.95v2.93h2.53V21h3.02Z"/></svg>',
  xsocial:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.75 3h3.07l-6.71 7.67L22 21h-6.18l-4.84-6.33L5.44 21H2.37l7.18-8.2L2 3h6.33l4.38 5.79L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.57l11.1 14.45Z"/></svg>',
};

const lucide: Record<string, string> = {
  truck, flame, zap, wind, filter, recycle, droplets, home, factory, chart, clock, pin, check, shield, leaf, play,
  share, copy, volume, square, menu, x, arrowRight, arrowDown, chevronDown, languages, mountain, users, briefcase,
  sun, cloudRain, thermometer, eye, fileText, download, mail, building, landmark, globe, alert, trash, bricks, gauge,
  activity, road, hardhat, plug, printer, heart, sparkles, ban, fish, map: mapIcon, calendar, scale, search, messages,
  plus, external,
};

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
  stroke?: number;
}
const { name, size = 24, class: cls = '', label, stroke = 1.75 } = Astro.props;
let svg = custom[name] ?? lucide[name];
if (!svg) throw new Error(`Icon "${name}" no existe`);
svg = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\swidth="[^"]*"/, '')
  .replace(/\sheight="[^"]*"/, '')
  .replace(/\sclass="[^"]*"/, '')
  .replace(/stroke-width="[^"]*"/, `stroke-width="${stroke}"`)
  .replace(
    '<svg',
    `<svg width="${size}" height="${size}" class="icon ${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`,
  );
---

<Fragment set:html={svg} />
